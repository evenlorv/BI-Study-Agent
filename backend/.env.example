# Server only. Never put real values in Git, frontend code or GitHub Pages.
OPENAI_API_KEY=
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STUDY_ACCESS_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGINS=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8787
# Across all authenticated requests, reset on restart. Use ONE backend instance.
MAX_REQUESTS_PER_DAY=30
